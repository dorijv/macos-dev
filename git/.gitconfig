[credential "https://github.com"]
	helper =
	helper = !/opt/homebrew/bin/gh auth git-credential
[credential "https://gist.github.com"]
	helper =
	helper = !/opt/homebrew/bin/gh auth git-credential
[init]
	defaultBranch = main
# No guessed name or email: commits fail until the folder has an identity
[user]
	useConfigOnly = true
# Identities live in ~/.gitconfig.local, outside the repo (install.sh creates it)
[include]
	path = ~/.gitconfig.local
