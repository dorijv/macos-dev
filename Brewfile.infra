# Infrastructure tools, installed with ./install.sh --infra
brew "tfenv"        # terraform versions: run `tfenv install` in a repo with .terraform-version
brew "terragrunt"
brew "tflint"       # run `tflint --init` in a repo with .tflint.hcl
brew "trivy"        # security scan: `trivy config .` (successor to tfsec)
brew "infracost"    # cost of a plan: run `infracost auth login` once, then `infracost breakdown --path .`
brew "pre-commit"   # run `pre-commit install` in a repo with .pre-commit-config.yaml
brew "uv"           # uvx runs the AWS MCP server for the aws-core Claude plugin
brew "awscli"
brew "direnv"
brew "aws-sso-util"
cask "session-manager-plugin"
